# Local defaults already work without this file.
A_DUEL_HOST=127.0.0.1
A_DUEL_SERVER_PORT=8787
A_DUEL_BASE_PATH=/a-duel
A_DUEL_DATA_FILE=./data/a-duel.json
A_DUEL_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Render provides PORT automatically. DATABASE_URL is optional and only needed for durable persistence.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# GitHub Pages build settings (configured as GitHub Actions variables).
# VITE_A_DUEL_BASE_PATH=/a-duel/
# VITE_A_DUEL_API_BASE=https://your-api.onrender.com/api
# VITE_A_DUEL_WS_BASE=wss://your-api.onrender.com/ws
